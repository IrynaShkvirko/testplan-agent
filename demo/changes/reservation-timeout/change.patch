+ALTER TABLE reservations ADD COLUMN expires_at TIMESTAMP;
+ALTER TABLE reservations ADD COLUMN confirmed BOOLEAN NOT NULL DEFAULT FALSE;
+-- reservations older than the new limit can never be confirmed
+DELETE FROM reservations WHERE created_at < NOW() - INTERVAL '15 minutes';
